def find_peak_usage(logs):
    counts = [0] * 24 
    for log in logs:
        dt = datetime.fromisoformat(log)
        hour = dt.hour
        counts[hour] = counts[hour] + 1 
        max_logins = max(counts)
        return counts.index(max_logins)

